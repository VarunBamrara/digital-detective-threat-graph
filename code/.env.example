# Digital Detective — environment configuration
# Copy this file to ".env" (same folder) and fill in real values.
# Never commit the real ".env" file to git.

# Groq API key — used by phase2_extract_triples.py and phase5_dashboard.py
# Get a free key at: https://console.groq.com
GROQ_API_KEY=

# Neo4j connection — used by phase3_build_graph.py, phase4_gnn_train.py,
# and phase5_dashboard.py
# Install Neo4j Desktop (https://neo4j.com/download), create a local DBMS,
# set a password, and start it before running phase3.
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
